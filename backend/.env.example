APP_NAME=LoreGuard
APP_VERSION=0.1.0
DEBUG=True

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=loreguard
DATABASE_USER=loreguard
DATABASE_PASSWORD=your_password_here
OBSIDIAN_VAULT_PATH=C:\path\to\your\vault

# Optional -- enables LLM prose fact extraction (step 19). Without
# it, everything else (frontmatter facts, events, conflict rules,
# embeddings) still works fine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
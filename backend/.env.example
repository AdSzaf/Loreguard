APP_NAME=LoreGuard
APP_VERSION=0.1.0
DEBUG=True

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=loreguard
DATABASE_USER=loreguard
DATABASE_PASSWORD=your_password_here
OBSIDIAN_VAULT_PATH=C:\path\to\your\vault

# Optional -- enables LLM prose fact extraction. Without
# any of this, everything else (frontmatter facts, events, conflict
# rules, embeddings) still works fine.
#
# LLM_PROVIDER=auto uses Gemini if GEMINI_API_KEY is set (it's
# free), otherwise Anthropic if ANTHROPIC_API_KEY is set. Set it to
# "anthropic" or "gemini" to force one explicitly.
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001